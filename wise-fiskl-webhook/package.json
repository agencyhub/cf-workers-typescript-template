{
  "name": "wise-fiskl-webhook",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic Cloudflare Worker: Wise balances#update → Fiskl transactions",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "wrangler check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "subscribe": "node scripts/subscribe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250906.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.34.0"
  }
}
